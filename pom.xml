<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/maven-v4_0_0.xsd">

    <parent>
        <artifactId>lutece-global-pom</artifactId>
        <groupId>fr.paris.lutece.tools</groupId>
        <version>8.0.4</version>
    </parent>

    <modelVersion>4.0.0</modelVersion>
    <groupId>fr.paris.lutece.plugins</groupId>
    <artifactId>module-appointment-solrsearchapp</artifactId>
    <packaging>lutece-plugin</packaging>
    <version>4.0.0-SNAPSHOT</version>
    <name>Lutece appointment solrsearchapp module</name>

    <repositories>
        <repository>
            <id>lutece</id>
            <name>luteceRepository</name>
            <url>https://dev.lutece.paris.fr/maven_repository</url>
            <layout>default</layout>
        </repository>
        <repository>
            <id>luteceSnapshot</id>
            <name>luteceSnapshot</name>
            <url>https://dev.lutece.paris.fr/snapshot_repository</url>
            <snapshots>
                <enabled>true</enabled>
            </snapshots>
        </repository>
    </repositories>

    <dependencyManagement>
        <dependencies>
            <!-- plugin-solr pulls plugin-leaflet [2.0.0,) : keep it on 2.0.x (2.1 requires lutece-core 8.1) -->
            <dependency>
                <groupId>fr.paris.lutece.plugins</groupId>
                <artifactId>plugin-leaflet</artifactId>
                <version>[2.0.0,2.0.999)</version>
                <type>lutece-plugin</type>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>fr.paris.lutece.plugins</groupId>
            <artifactId>plugin-solr</artifactId>
            <version>[5.0.0,5.0.999)</version>
            <type>lutece-plugin</type>
            <exclusions>
                <!-- avoid library-core-utils version conflict -->
                <exclusion>
                    <groupId>fr.paris.lutece</groupId>
                    <artifactId>lutece-core</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <dependency>
            <groupId>fr.paris.lutece</groupId>
            <artifactId>lutece-core</artifactId>
            <version>[8.0.0,8.0.999)</version>
            <type>lutece-core</type>
        </dependency>
        <dependency>
            <groupId>fr.paris.lutece.plugins</groupId>
            <artifactId>library-lutece-unit-testing</artifactId>
            <type>jar</type>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <properties>
        <componentName>appointment-solrsearchapp</componentName>
        <sonar.tests />
    </properties>

    <scm>
        <connection>scm:git:https://github.com/lutece-secteur-public/gru-module-appointment-solrsearchapp.git</connection>
        <developerConnection>scm:git:https://github.com/lutece-secteur-public/gru-module-appointment-solrsearchapp.git</developerConnection>
        <url>https://github.com/lutece-secteur-public/gru-module-appointment-solrsearchapp.git</url>
        <tag>HEAD</tag>
    </scm>

</project>
